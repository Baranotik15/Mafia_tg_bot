BOT_TOKEN=your_telegram_bot_token_here
WEBAPP_URL=https://your-domain.com
SECRET_KEY=django-dev-secret-key-change-in-production
DEBUG=True

# Database: 'sqlite' for local dev, 'postgres' for production
DB_ENGINE=sqlite

# PostgreSQL (only needed when DB_ENGINE=postgres)
DB_NAME=mafia
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# Dev auth (only used when DEBUG=True)
DEV_PLAYER_ID=1
